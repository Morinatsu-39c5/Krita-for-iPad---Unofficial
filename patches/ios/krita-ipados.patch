diff --git a/packaging/ios/KritaIOS.cmake b/packaging/ios/KritaIOS.cmake
new file mode 100644
index 0000000..eeab8f2
--- /dev/null
+++ b/packaging/ios/KritaIOS.cmake
@@ -0,0 +1,170 @@
+# SPDX-License-Identifier: BSD-3-Clause
+# Bundle metadata for device builds; signing identities remain caller supplied.
+function(krita_configure_ios_bundle target)
+    set(KRITA_IOS_BUNDLE_ID "org.example.krita" CACHE STRING "iPadOS bundle identifier")
+    set(KRITA_IOS_TEAM_ID "" CACHE STRING "Apple development team")
+    set_target_properties(${target} PROPERTIES
+        MACOSX_BUNDLE TRUE
+        MACOSX_BUNDLE_GUI_IDENTIFIER "${KRITA_IOS_BUNDLE_ID}"
+        MACOSX_BUNDLE_INFO_PLIST "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/Info.plist.in"
+        XCODE_ATTRIBUTE_PRODUCT_BUNDLE_IDENTIFIER "${KRITA_IOS_BUNDLE_ID}"
+        XCODE_ATTRIBUTE_TARGETED_DEVICE_FAMILY "2"
+        XCODE_ATTRIBUTE_CODE_SIGN_STYLE "Automatic")
+    if(KRITA_IOS_TEAM_ID)
+        set_target_properties(${target} PROPERTIES
+            XCODE_ATTRIBUTE_CODE_SIGNING_ALLOWED "YES"
+            XCODE_ATTRIBUTE_DEVELOPMENT_TEAM "${KRITA_IOS_TEAM_ID}")
+    endif()
+    set(_font_config "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/fonts.conf")
+    set_source_files_properties("${_font_config}" PROPERTIES MACOSX_PACKAGE_LOCATION "etc/fonts")
+    set(_app_icon "${CMAKE_SOURCE_DIR}/krita/pics/branding/default/1024-apps-krita.png")
+    set_source_files_properties("${_app_icon}" PROPERTIES MACOSX_PACKAGE_LOCATION ".")
+    target_sources(${target} PRIVATE "${_font_config}" "${_app_icon}")
+
+    # ki18n's default install rule has no component, while Xcode's post-build
+    # staging deliberately installs only the Krita application component.
+    # Add component-aware rules for Krita and its statically linked KDE
+    # Frameworks catalogs so both Ninja packaging and Xcode Run are localized.
+    install(DIRECTORY "${CMAKE_BINARY_DIR}/locale/"
+        DESTINATION "share/locale" COMPONENT krita)
+    if(KF6I18n_DIR)
+        get_filename_component(_kf6_ios_prefix "${KF6I18n_DIR}/../../.." ABSOLUTE)
+        if(EXISTS "${_kf6_ios_prefix}/share/locale")
+            install(DIRECTORY "${_kf6_ios_prefix}/share/locale/"
+                DESTINATION "share/locale" COMPONENT krita)
+        endif()
+    endif()
+    if(CMAKE_GENERATOR MATCHES "Xcode")
+        # A normal Xcode Run builds the application target but does not invoke
+        # CMake's install rules. Krita keeps its brushes, actions, profiles and
+        # other runtime data in the install share tree, so stage those rules and
+        # copy the resulting data into the bundle after the executable links.
+        # These installable libraries are not otherwise in the application's
+        # link graph. Build them so the shared "krita" install component is
+        # complete when the post-build staging command runs.
+        add_dependencies(${target} kritalibkis kritaexifcommon)
+        set(_xcode_install_root "${CMAKE_BINARY_DIR}/ios-xcode-install/$<CONFIG>")
+        add_custom_command(TARGET ${target} POST_BUILD
+            COMMAND "${CMAKE_COMMAND}" --install "${CMAKE_BINARY_DIR}"
+                --config "$<CONFIG>" --prefix "${_xcode_install_root}"
+                --component krita
+            COMMAND "${CMAKE_COMMAND}" -E rm -rf
+                "$<TARGET_BUNDLE_DIR:${target}>/share"
+            COMMAND "${CMAKE_COMMAND}" -E copy_directory
+                "${_xcode_install_root}/share"
+                "$<TARGET_BUNDLE_DIR:${target}>/share"
+            COMMENT "Installing Krita runtime data into the iPadOS app bundle"
+            VERBATIM)
+    endif()
+    # The legacy Krita finder exports only libexiv2's path. Its CMake target
+    # carries the Expat, zlib, Brotli and iconv dependencies needed for static linking.
+    list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/cmake")
+    find_package(exiv2 CONFIG REQUIRED)
+    target_link_libraries(${target} PRIVATE Exiv2::exiv2lib)
+    get_property(_plugins GLOBAL PROPERTY KRITA_IOS_PLUGIN_TARGETS)
+    get_property(_resources GLOBAL PROPERTY KRITA_IOS_STATIC_RESOURCES)
+    if(NOT _resources)
+        message(FATAL_ERROR "No iOS static resources were registered")
+    endif()
+    set(_resource_source "#include <QtCore/QDebug>\n#include <QtCore/QResource>\n#include <QtCore/QString>\n\nbool kritaInitializeIosStaticResources()\n{\n    bool valid = true;\n")
+    string(ASCII 9 _resource_tab)
+    set(_resource_manifest "# resource-name${_resource_tab}sentinel${_resource_tab}qrc-source\n")
+    set(_resource_names)
+    foreach(_resource IN LISTS _resources)
+        string(REPLACE "|" ";" _resource_fields "${_resource}")
+        list(LENGTH _resource_fields _resource_field_count)
+        if(NOT _resource_field_count EQUAL 3)
+            message(FATAL_ERROR "Invalid iOS static resource registration: ${_resource}")
+        endif()
+        list(GET _resource_fields 0 _resource_name)
+        list(GET _resource_fields 1 _resource_sentinel)
+        list(GET _resource_fields 2 _resource_qrc)
+        if(_resource_name IN_LIST _resource_names)
+            message(FATAL_ERROR "Duplicate iOS static resource name: ${_resource_name}")
+        endif()
+        list(APPEND _resource_names "${_resource_name}")
+        string(APPEND _resource_source
+            "    Q_INIT_RESOURCE(${_resource_name});\n"
+            "    if (!QResource(QStringLiteral(\"${_resource_sentinel}\")).isValid()) {\n"
+            "        qCritical() << \"Missing iOS static resource:\" << QStringLiteral(\"${_resource_sentinel}\");\n"
+            "        valid = false;\n"
+            "    }\n")
+        string(APPEND _resource_manifest
+            "${_resource_name}${_resource_tab}${_resource_sentinel}${_resource_tab}${_resource_qrc}\n")
+    endforeach()
+    string(APPEND _resource_source "    return valid;\n}\n")
+    set(_resource_source_path "${CMAKE_CURRENT_BINARY_DIR}/krita_ios_resources.cpp")
+    set(_resource_manifest_path "${CMAKE_CURRENT_BINARY_DIR}/ios-static-resources.tsv")
+    file(WRITE "${_resource_source_path}" "${_resource_source}")
+    file(WRITE "${_resource_manifest_path}" "${_resource_manifest}")
+    target_sources(${target} PRIVATE "${_resource_source_path}")
+    set(_imports "#include <QtPlugin>\n#include <QtQml/qqmlextensionplugin.h>\n")
+    get_target_property(_qml_class kritaqmlcomponents QT_QML_MODULE_CLASS_NAME)
+    if(NOT _qml_class)
+        message(FATAL_ERROR "Krita QML plugin class is missing")
+    endif()
+    string(APPEND _imports "Q_IMPORT_QML_PLUGIN(${_qml_class})\n")
+    target_link_libraries(${target} PRIVATE kritaqmlcomponents)
+    foreach(_plugin IN LISTS _plugins)
+        get_target_property(_sources ${_plugin} SOURCES)
+        get_target_property(_source_dir ${_plugin} SOURCE_DIR)
+        set(_factory_found FALSE)
+        set(_static_sources ${_sources})
+        foreach(_source IN LISTS _sources)
+            set(_source_entry "${_source}")
+            if(NOT IS_ABSOLUTE "${_source}")
+                set(_source "${_source_dir}/${_source}")
+            endif()
+            if(EXISTS "${_source}" AND _source MATCHES "\\.(cpp|cc|cxx)$")
+                file(READ "${_source}" _contents)
+                string(REGEX MATCH "K_PLUGIN_FACTORY(_WITH_JSON)?[ \t\r\n]*\\([ \t\r\n]*([A-Za-z_][A-Za-z_0-9]*)" _match "${_contents}")
+                if(_match)
+                    # Desktop DSOs can reuse factory class names. Static factories
+                    # share one symbol table, so give every target its own name.
+                    set(_factory "${CMAKE_MATCH_2}")
+                    set(_static_factory "${_plugin}_${_factory}")
+                    # Rename in a generated source copy: moc must see the literal
+                    # class name, not a compiler-only macro alias (Qt token-pastes it).
+                    string(REPLACE "${_factory}" "${_static_factory}" _renamed_match "${_match}")
+                    string(REPLACE "${_match}" "${_renamed_match}" _static_contents "${_contents}")
+                    get_filename_component(_filename "${_source}" NAME)
+                    get_filename_component(_source_parent "${_source}" DIRECTORY)
+                    set(_static_dir "${CMAKE_CURRENT_BINARY_DIR}/ios-plugin-sources/${_plugin}")
+                    file(MAKE_DIRECTORY "${_static_dir}")
+                    set_property(TARGET ${_plugin} PROPERTY AUTOGEN_BUILD_DIR "${_static_dir}/autogen")
+                    set(_static_source "${_static_dir}/${_filename}")
+                    set(_existing_contents "")
+                    if(EXISTS "${_static_source}")
+                        file(READ "${_static_source}" _existing_contents)
+                    endif()
+                    if(NOT _existing_contents STREQUAL _static_contents)
+                        file(WRITE "${_static_source}" "${_static_contents}")
+                    endif()
+                    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_source}")
+                    list(REMOVE_ITEM _static_sources "${_source_entry}")
+                    list(APPEND _static_sources "${_static_source}")
+                    set_property(TARGET ${_plugin} APPEND PROPERTY AUTOGEN_TARGET_DEPENDS "${_static_source}")
+                    get_filename_component(_stem "${_source}" NAME_WE)
+                    foreach(_suffix h hpp)
+                        if(EXISTS "${_source_parent}/${_stem}.${_suffix}")
+                            list(APPEND _static_sources "${_source_parent}/${_stem}.${_suffix}")
+                        endif()
+                    endforeach()
+                    target_include_directories(${_plugin} PRIVATE "${_source_parent}")
+                    string(APPEND _imports "Q_IMPORT_PLUGIN(${_static_factory})\n")
+                    set(_factory_found TRUE)
+                endif()
+            endif()
+        endforeach()
+        list(REMOVE_DUPLICATES _static_sources)
+        set_property(TARGET ${_plugin} PROPERTY SOURCES "${_static_sources}")
+        if(NOT _factory_found)
+            message(FATAL_ERROR "No static factory found for iOS plugin ${_plugin}")
+        endif()
+    endforeach()
+    file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/krita_ios_plugins.cpp" "${_imports}")
+    target_sources(${target} PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/krita_ios_plugins.cpp")
+    target_link_libraries(${target} PRIVATE ${_plugins})
+    # Qt finalization also imports the official static platform and QML plugins.
+    qt_finalize_executable(${target})
+endfunction()
