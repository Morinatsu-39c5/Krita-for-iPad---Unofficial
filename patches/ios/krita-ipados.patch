+bool hasIosNonTextEditorAncestor(QWidget *widget)
+{
+    for (QWidget *ancestor = widget ? widget->parentWidget() : nullptr;
+         ancestor;
+         ancestor = ancestor->parentWidget()) {
+        if (qobject_cast<QAbstractSpinBox *>(ancestor) || qobject_cast<QComboBox *>(ancestor)) {
+            return true;
+        }
+    }
+    return false;
+}
+
+bool isIosExplicitTextInput(QWidget *widget)
+{
+    if (!widget) {
+        return false;
+    }
+
+    if (widget->property(s_iosExplicitTextInputProperty).toBool()) {
+        return true;
+    }
+
+    if (hasIosNonTextEditorAncestor(widget)) {
+        return false;
+    }
+
+    return qobject_cast<QLineEdit *>(widget)
+        || qobject_cast<QTextEdit *>(widget)
+        || qobject_cast<QPlainTextEdit *>(widget);
+}
+
+void hideIosInputMethod()
+{
+    // Qt's native iOS combo-box picker is an inputView on the same responder
+    // as the keyboard. Resetting/hiding that responder cancels the picker.
+    if (QObject *focusObject = QGuiApplication::focusObject()) {
+        QInputMethodQueryEvent query(Qt::ImPlatformData);
+        QCoreApplication::sendEvent(focusObject, &query);
+        if (query.value(Qt::ImPlatformData).toMap().value(QStringLiteral("inputView")).value<void *>()) {
+            return;
+        }
+    }
+
+    QInputMethod *inputMethod = QGuiApplication::inputMethod();
+    if (inputMethod && inputMethod->isVisible()) {
+        inputMethod->reset();
+        inputMethod->hide();
+    }
+}
+
+class IosInputMethodGuard final : public QObject
+{
+public:
+    explicit IosInputMethodGuard(QObject *parent)
+        : QObject(parent)
+    {
+    }
+
+    bool eventFilter(QObject *watched, QEvent *event) override
+    {
+        switch (event->type()) {
+        case QEvent::FocusIn:
+        case QEvent::MouseButtonPress:
+        case QEvent::TouchBegin: {
+            QWidget *widget = qobject_cast<QWidget *>(watched);
+            if (widget && !isIosExplicitTextInput(widget)) {
+                // Run after Qt's focus processing, which may otherwise show
+                // the iOS keyboard again after this event filter returns.
+                if (!m_hidePending) {
+                    m_hidePending = true;
+                    QTimer::singleShot(0, this, [this]() {
+                        m_hidePending = false;
+                        // Focus may have moved to a real editor while this
+                        // callback was queued. Use the current focus, rather
+                        // than the non-text widget that scheduled the hide.
+                        if (!isIosExplicitTextInput(QApplication::focusWidget())) {
+                            hideIosInputMethod();
+                        }
+                    });
+                }
+            }
+            break;
+        }
+        default:
+            break;
+        }
+        return false;
+    }
+
+private:
+    bool m_hidePending = false;
+};
+
+void installIosInputMethodGuard()
+{
+    static bool installed = false;
+    if (!installed && qApp) {
+        qApp->installEventFilter(new IosInputMethodGuard(qApp));
+        installed = true;
+    }
+}
+
+void updateIosInputMethod(KisCanvas2 *canvas, bool textMode)
+{
+    if (!canvas || !canvas->canvasWidget()) {
+        return;
+    }
+
+    canvas->canvasWidget()->setProperty(s_iosExplicitTextInputProperty, textMode);
+    canvas->canvasWidget()->setAttribute(Qt::WA_InputMethodEnabled, textMode);
+    if (!textMode) {
+        hideIosInputMethod();
+    }
+}
