+QString iosDocumentsDirectory()
+{
+    const QString path = QStandardPaths::writableLocation(QStandardPaths::DocumentsLocation);
+    if (!path.isEmpty() && !QDir().mkpath(path)) {
+        qWarning() << "Could not create the iOS Documents directory:" << path;
+    }
+    return path;
+}
+
+QString iosSuggestedDocumentPath(KisDocument *document)
+{
+    QString baseName = document ? document->documentInfo()->aboutInfo("title") : QString();
+    if (baseName.isEmpty() || baseName == i18n("Unnamed")) {
+        baseName = i18n("Untitled");
+    }
+
+    baseName.replace(QLatin1Char('/'), QLatin1Char('-'));
+
+    const QString suffix = KisMimeDatabase::suffixesForMimeType(KIS_MIME_TYPE).value(0, QStringLiteral("kra"));
+    return QDir(iosDocumentsDirectory()).filePath(baseName + QLatin1Char('.') + suffix);
+}
+
+QString iosUniqueDocumentPath(KisDocument *document, bool makeCopy)
+{
+    QString suggestedPath = iosSuggestedDocumentPath(document);
+    QFileInfo suggestedInfo(suggestedPath);
+    QString baseName = suggestedInfo.completeBaseName();
+
+    if (makeCopy) {
+        baseName += i18n(" Copy");
+    }
+
+    const QDir directory = suggestedInfo.dir();
+    const QString suffix = suggestedInfo.suffix();
+    QString candidate = directory.filePath(baseName + QLatin1Char('.') + suffix);
+    int copyNumber = 2;
+    while (QFileInfo::exists(candidate)) {
+        candidate = directory.filePath(baseName + QLatin1Char(' ') + QString::number(copyNumber++)
+                                       + QLatin1Char('.') + suffix);
+    }
+    return candidate;
+}
+}
+#endif
