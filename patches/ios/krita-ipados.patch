+#ifdef Q_OS_IOS
+void KisView::requestIosCloseConfirmation()
+{
+    d->iosClosePending = true;
+    QTimer::singleShot(0, this, [this]() {
+        if (!document() || QApplication::activeModalWidget()) {
+            d->iosClosePending = false;
+            return;
+        }
+
+        QString name = QFileInfo(document()->path()).fileName();
+        if (name.isEmpty()) {
+            name = i18n("Untitled");
+        }
+
+        // Keep the confirmation in the Qt widget hierarchy. UIKit's native
+        // alert helper presents from the root controller, which may already
+        // be presenting/dismissing another controller.
+        auto *prompt = new QMessageBox(QMessageBox::Warning,
+                                      i18nc("@title:window", "Krita"),
+                                      i18n("<p>The document <b>'%1'</b> has been modified.</p><p>Do you want to save it?</p>", name),
+                                      QMessageBox::Yes | QMessageBox::No | QMessageBox::Cancel,
+                                      mainWindow());
+        prompt->setOption(QMessageBox::Option::DontUseNativeDialog);
+        prompt->setDefaultButton(QMessageBox::Yes);
+        prompt->setWindowModality(Qt::ApplicationModal);
+        prompt->setAttribute(Qt::WA_DeleteOnClose);
+        d->iosClosePrompt = prompt;
+
+        const QPointer<KisDocument> closingDocument = document();
+        connect(prompt, &QDialog::finished, this, [this, closingDocument](int result) {
+            d->iosClosePrompt = nullptr;
+            // Let the confirmation finish hiding before saving or destroying
+            // the view. All callbacks are cancelled if this view is destroyed.
+            QTimer::singleShot(0, this, [this, closingDocument, result]() {
+                if (!closingDocument || document() != closingDocument) {
+                    d->iosClosePending = false;
+                    return;
+                }
+                if (result != QMessageBox::Yes && result != QMessageBox::No) {
+                    d->iosClosePending = false;
+                    return;
+                }
+
+                if (KisImageSP image = document()->image()) {
+                    if (result == QMessageBox::Yes) {
+                        image->requestStrokeEnd();
+                    } else {
+                        image->requestStrokeCancellation();
+                    }
+                }
+
+                // Both saveDocument() and the forced-operation wait can open
+                // another synchronous progress dialog if the image is busy.
+                // Let pending strokes and any autosave finish in the normal
+                // event loop before entering either completion path.
+                auto *timer = new QTimer(this);
+                timer->setInterval(100);
+                connect(timer, &QTimer::timeout, this, [this, timer, closingDocument, result]() {
+                    if (!closingDocument || document() != closingDocument) {
+                        timer->stop();
+                        timer->deleteLater();
+                        d->iosClosePending = false;
+                        return;
+                    }
+                    KisImageSP image = document()->image();
+                    if (document()->isSaving() || (image && !image->isIdle(result == QMessageBox::No))) {
+                        return;
+                    }
+                    timer->stop();
+                    timer->deleteLater();
+
+                    if (result == QMessageBox::Yes) {
+                        const bool isNative = document()->mimeType() == document()->nativeFormatMimeType();
+                        if (!mainWindow() || !mainWindow()->saveDocument(document(), !isNative, false)) {
+                            d->iosClosePending = false;
+                            return;
+                        }
+                        waitForIosSaveBeforeClose(true);
+                    } else {
+                        document()->removeAutoSaveFiles(document()->localFilePath(), document()->isRecovered());
+                        document()->setModified(false);
+                        d->iosClosePending = false;
+                        closeView();
+                    }
+                });
+                timer->start();
+            });
+        });
+        prompt->show();
+    });
+}
+
+void KisView::waitForIosSaveBeforeClose(bool closeAfterSave)
+{
+    d->iosClosePending = true;
+    auto *timer = new QTimer(this);
+    timer->setInterval(100);
+    connect(timer, &QTimer::timeout, this, [this, timer, closeAfterSave]() {
+        if (document() && document()->isSaving()) {
+            return;
+        }
+        timer->stop();
+        timer->deleteLater();
+        d->iosClosePending = false;
+
+        if (closeAfterSave && document() && document()->isModified()) {
+            // A failed/cancelled save, or edits made during the save, must
+            // leave the document open. Never treat "save started" as success.
+            return;
+        }
+        closeView();
+    });
+    timer->start();
 }
+#endif
 
