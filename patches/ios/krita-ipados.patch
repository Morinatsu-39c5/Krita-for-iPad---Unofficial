new file mode 100644
index 0000000..bb4fc67
--- /dev/null
+++ b/krita/krita_ios_pencil_bridge.cpp
@@ -0,0 +1,63 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Krita contributors
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include <cmath>
+
+#include <QApplication>
+#include <QAction>
+#include <QPoint>
+#include <QWidget>
+
+#include <kactioncollection.h>
+#include <KisMainWindow.h>
+#include <KisPart.h>
+#include <KisViewManager.h>
+#include <canvas/kis_canvas2.h>
+#include <input/kis_input_manager.h>
+
+extern "C" void kritaToggleIosPopupWidget(double screenX, double screenY, bool hasPosition)
+{
+    if (!qApp) {
+        return;
+    }
+
+    KisMainWindow *mainWindow = KisPart::instance()->currentMainwindow();
+    if (!mainWindow || !mainWindow->viewManager()) {
+        return;
+    }
+
+    KisInputManager *inputManager = mainWindow->viewManager()->inputManager();
+    if (!inputManager || !inputManager->canvas() || !inputManager->canvas()->canvasWidget()) {
+        return;
+    }
+
+    QWidget *canvasWidget = inputManager->canvas()->canvasWidget();
+    QPoint canvasPosition = canvasWidget->rect().center();
+    if (hasPosition && std::isfinite(screenX) && std::isfinite(screenY)) {
+        const QPoint mappedPosition = canvasWidget->mapFromGlobal(QPoint(qRound(screenX), qRound(screenY)));
+        if (canvasWidget->rect().contains(mappedPosition)) {
+            canvasPosition = mappedPosition;
+        }
+    }
+
+    inputManager->togglePopupWidgetAt(canvasPosition);
+}
+
+extern "C" void kritaToggleIosEraserMode()
+{
+    if (!qApp) {
+        return;
+    }
+
+    KisMainWindow *mainWindow = KisPart::instance()->currentMainwindow();
+    if (!mainWindow || !mainWindow->actionCollection()) {
+        return;
+    }
+
+    QAction *eraseAction = mainWindow->actionCollection()->action(QStringLiteral("erase_action"));
+    if (eraseAction && eraseAction->isEnabled()) {
+        eraseAction->trigger();
+    }
+}
diff --git a/krita/krita_ios_touch_guard.mm b/krita/krita_ios_touch_guard.mm
new file mode 100644
index 0000000..9f948da
--- /dev/null
+++ b/krita/krita_ios_touch_guard.mm
@@ -0,0 +1,245 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Krita contributors
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#import <UIKit/UIKit.h>
+#import <objc/runtime.h>
+
+extern "C" void kritaToggleIosPopupWidget(double screenX, double screenY, bool hasPosition);
+extern "C" void kritaToggleIosEraserMode();
+
+@interface KritaIOSTouchGuard : NSObject
+- (void)kritaDidMoveToWindow;
+- (void)kritaTouchesBegan:(NSSet<UITouch *> *)touches withEvent:(UIEvent *)event;
+- (void)kritaTouchesEnded:(NSSet<UITouch *> *)touches withEvent:(UIEvent *)event;
+- (void)kritaTouchesCancelled:(NSSet<UITouch *> *)touches withEvent:(UIEvent *)event;
+@end
+
+@interface KritaIOSPencilInteractionDelegate : NSObject <UIPencilInteractionDelegate>
+@end
+
+namespace {
+
+char s_guardedPencilTouchesKey;
+char s_lastPencilLocationKey;
+char s_pencilInteractionKey;
+char s_pencilInteractionDelegateKey;
+Ivar s_activePencilTouchIvar = nullptr;
+
+NSMutableSet<UITouch *> *guardedPencilTouches(id view, bool create)
+{
+    NSMutableSet<UITouch *> *touches = objc_getAssociatedObject(view, &s_guardedPencilTouchesKey);
+    if (!touches && create) {
+        touches = [NSMutableSet set];
+        objc_setAssociatedObject(view, &s_guardedPencilTouchesKey, touches,
+                                 OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+    }
+    return touches;
+}
+
+void retainPencilTouches(id view, NSSet<UITouch *> *touches)
+{
+    NSMutableSet<UITouch *> *guardedTouches = guardedPencilTouches(view, true);
+    for (UITouch *touch in touches) {
+        if (touch.type == UITouchTypeStylus) {
+            [guardedTouches addObject:touch];
+            const CGPoint location = [touch locationInView:view];
+            objc_setAssociatedObject(view, &s_lastPencilLocationKey,
+                                     [NSValue valueWithCGPoint:location],
+                                     OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+        }
+    }
+}
+
+void releasePencilTouches(id view, NSSet<UITouch *> *touches)
+{
+    NSMutableSet<UITouch *> *guardedTouches = guardedPencilTouches(view, false);
+    for (UITouch *touch in touches) {
+        if (touch.type == UITouchTypeStylus) {
+            [guardedTouches removeObject:touch];
+        }
+    }
+}
+
+void togglePopupWidget(UIView *sourceView, CGPoint sourcePosition, bool hasPosition)
+{
+    if (!sourceView) {
+        return;
+    }
+
+    CGPoint screenPosition = CGPointZero;
+    if (hasPosition) {
+        const CGPoint windowPosition = [sourceView convertPoint:sourcePosition toView:sourceView.window];
+        screenPosition = [sourceView.window convertPoint:windowPosition toWindow:nil];
+    }
+    kritaToggleIosPopupWidget(screenPosition.x, screenPosition.y, hasPosition);
+}
+
+void togglePopupWidget(UIPencilInteraction *interaction, UIPencilHoverPose *hoverPose)
+{
+    UIView *view = interaction.view;
+    if (!view) {
+        return;
+    }
+
+    if (hoverPose) {
+        togglePopupWidget(view, hoverPose.location, true);
+        return;
+    }
+
+    NSValue *lastLocation = objc_getAssociatedObject(view, &s_lastPencilLocationKey);
+    togglePopupWidget(view, lastLocation ? lastLocation.CGPointValue : CGPointZero,
+                      lastLocation != nil);
+}
+
+void installPencilInteraction(UIView *view)
+{
+    if (!view.window || objc_getAssociatedObject(view, &s_pencilInteractionKey)) {
+        return;
+    }
+
+    KritaIOSPencilInteractionDelegate *delegate = [KritaIOSPencilInteractionDelegate new];
+    UIPencilInteraction *interaction = [UIPencilInteraction new];
+    interaction.delegate = delegate;
+    interaction.enabled = YES;
+    [view addInteraction:interaction];
+
+    // UIPencilInteraction.delegate is weak, so retain both objects with QUIView.
+    objc_setAssociatedObject(view, &s_pencilInteractionDelegateKey, delegate,
+                             OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+    objc_setAssociatedObject(view, &s_pencilInteractionKey, interaction,
+                             OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+}
+
+bool installMethodGuard(Class viewClass, SEL originalSelector, SEL guardedSelector)
+{
+    Method originalMethod = class_getInstanceMethod(viewClass, originalSelector);
+    Method guardedMethod = class_getInstanceMethod([KritaIOSTouchGuard class], guardedSelector);
+    if (!originalMethod || !guardedMethod) {
+        return false;
+    }
+
+    // class_getInstanceMethod() also returns inherited methods. Exchanging an
+    // inherited UIView method would therefore affect every UIKit view, not
+    // only Qt's QUIView. Materialize the inherited implementation as a QUIView
+    // override before exchanging it with the guard.
+    class_addMethod(viewClass,
+                    originalSelector,
+                    method_getImplementation(originalMethod),
+                    method_getTypeEncoding(originalMethod));
+    originalMethod = class_getInstanceMethod(viewClass, originalSelector);
+
+    if (!class_addMethod(viewClass,
+                         guardedSelector,
+                         method_getImplementation(guardedMethod),
+                         method_getTypeEncoding(guardedMethod))) {
+        return false;
+    }
+
+    Method installedGuardMethod = class_getInstanceMethod(viewClass, guardedSelector);
+    method_exchangeImplementations(originalMethod, installedGuardMethod);
+    return true;
+}
+
+} // namespace
+
+@implementation KritaIOSTouchGuard
+
+- (void)kritaDidMoveToWindow
+{
+    [self kritaDidMoveToWindow];
+    installPencilInteraction((UIView *)self);
+}
+
+- (void)kritaTouchesBegan:(NSSet<UITouch *> *)touches withEvent:(UIEvent *)event
+{
+    NSMutableSet<UITouch *> *guardedTouches = guardedPencilTouches(self, true);
+
+    // Qt 6.10 stores this UITouch in a non-retaining ivar. If UIKit omits the
+    // matching ended/cancelled callback, that ivar can point to a deallocated
+    // object on the next touch sequence. Drop a retained stale touch before Qt
+    // asks the new NSSet to compare against it.
+    if (s_activePencilTouchIvar) {
+        id activePencilTouch = object_getIvar(self, s_activePencilTouchIvar);
+        if (activePencilTouch && ![touches containsObject:activePencilTouch]) {
+            object_setIvar(self, s_activePencilTouchIvar, nil);
+            [guardedTouches removeObject:activePencilTouch];
+        }
+    }
+
+    retainPencilTouches(self, touches);
+    [self kritaTouchesBegan:touches withEvent:event];
+}
+
+- (void)kritaTouchesEnded:(NSSet<UITouch *> *)touches withEvent:(UIEvent *)event
+{
+    // Keep every Pencil UITouch alive until Qt has finished handleTouches().
+    retainPencilTouches(self, touches);
+    [self kritaTouchesEnded:touches withEvent:event];
+    releasePencilTouches(self, touches);
+}
+
+- (void)kritaTouchesCancelled:(NSSet<UITouch *> *)touches withEvent:(UIEvent *)event
+{
+    retainPencilTouches(self, touches);
+    [self kritaTouchesCancelled:touches withEvent:event];
+    [guardedPencilTouches(self, false) removeAllObjects];
+}
+
+@end
+
+@implementation KritaIOSPencilInteractionDelegate
+
+- (void)pencilInteractionDidTap:(UIPencilInteraction *)interaction
+{
+    (void)interaction;
+    kritaToggleIosEraserMode();
+}
+
+- (void)pencilInteraction:(UIPencilInteraction *)interaction
+             didReceiveTap:(UIPencilInteractionTap *)tap
+{
+    (void)interaction;
+    (void)tap;
+    kritaToggleIosEraserMode();
+}
+
+- (void)pencilInteraction:(UIPencilInteraction *)interaction
+         didReceiveSqueeze:(UIPencilInteractionSqueeze *)squeeze
+{
+    if (squeeze.phase == UIPencilInteractionPhaseBegan) {
+        togglePopupWidget(interaction, squeeze.hoverPose);
+    }
+}
+
+@end
+
+extern "C" void kritaInstallIosTouchGuard()
+{
+    static bool installed = false;
+    if (installed) {
+        return;
+    }
+
+    Class viewClass = NSClassFromString(@"QUIView");
+    if (!viewClass) {
+        return;
+    }
+
+    s_activePencilTouchIvar = class_getInstanceVariable(viewClass, "m_activePencilTouch");
+
+    const bool moveInstalled = installMethodGuard(viewClass,
+                                                  @selector(didMoveToWindow),
+                                                  @selector(kritaDidMoveToWindow));
+    const bool beganInstalled = installMethodGuard(viewClass,
+                                                   @selector(touchesBegan:withEvent:),
+                                                   @selector(kritaTouchesBegan:withEvent:));
+    const bool endedInstalled = installMethodGuard(viewClass,
+                                                   @selector(touchesEnded:withEvent:),
+                                                   @selector(kritaTouchesEnded:withEvent:));
+    const bool cancelledInstalled = installMethodGuard(viewClass,
+                                                       @selector(touchesCancelled:withEvent:),
+                                                       @selector(kritaTouchesCancelled:withEvent:));
+    installed = moveInstalled && beganInstalled && endedInstalled && cancelledInstalled;
+}
