diff --git a/cmake/FindLibIntl.cmake b/cmake/FindLibIntl.cmake
index a7f9167..9158276 100644
--- a/cmake/FindLibIntl.cmake
+++ b/cmake/FindLibIntl.cmake
@@ -45,5 +45,12 @@ endif()
 # make sure we have -Wl,--no-undefined here, otherwise this test will always pass
 cmake_push_check_state()
 set(CMAKE_REQUIRED_LIBRARIES ${LibIntl_LIBRARIES} ${CMAKE_SHARED_LINKER_FLAGS})
+if(CMAKE_SYSTEM_NAME STREQUAL "iOS")
+    # Static GNU libintl needs both Apple's locale preferences and iconv.
+    # Missing transitive libraries would falsely disable language-cache reset.
+    find_library(LibIntl_CoreFoundation_LIBRARY CoreFoundation REQUIRED)
+    find_library(LibIntl_Iconv_LIBRARY iconv REQUIRED)
+    list(APPEND CMAKE_REQUIRED_LIBRARIES ${LibIntl_CoreFoundation_LIBRARY} ${LibIntl_Iconv_LIBRARY})
+endif()
 check_cxx_source_compiles("extern \"C\" int _nl_msg_cat_cntr; int main(void) { ++_nl_msg_cat_cntr; return 0; }" HAVE_NL_MSG_CAT_CNTR)
 cmake_pop_check_state()
